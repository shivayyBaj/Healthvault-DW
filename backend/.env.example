# HealthVault DW - Backend Configuration
# Copy this file to .env and configure your local settings

# API Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=8000

# Database Configuration
# Default is SQLite for local development
DATABASE_URL=sqlite:///healthvault.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/healthvault_db

# Security
# Never commit the actual SECRET_KEY to version control
SECRET_KEY=generate-a-secure-random-key-here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Machine Learning
# Toggle to enable/disable heavy computations
ENABLE_XAI=true
ML_MODEL_CACHE_DIR=./cache/models
